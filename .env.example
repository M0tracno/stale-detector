# Tavily: free key (1,000 searches/month, no card) at https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxx

# Bifrost gateway (run: npx -y @maximhq/bifrost  -> UI at http://localhost:8080)
# Add a provider key in the Bifrost UI. Free options, no card needed:
#   Groq   -> https://console.groq.com/keys
#   Gemini -> https://aistudio.google.com/apikey
BIFROST_URL=http://localhost:8080
# Optional: Bifrost virtual key for budgets / rate limits
BIFROST_VIRTUAL_KEY=

# Models are "provider/model" as configured in Bifrost.
# Groq (free):   groq/llama-3.1-8b-instant   + groq/llama-3.3-70b-versatile
# Gemini (free): gemini/gemini-2.5-flash-lite + gemini/gemini-2.5-flash
# OpenAI (paid): openai/gpt-4o-mini          + openai/gpt-4o
FAST_MODEL=groq/llama-3.1-8b-instant
STRONG_MODEL=groq/llama-3.3-70b-versatile
# Comma-separated; Bifrost tries these if the primary provider fails
FALLBACK_MODELS=gemini/gemini-2.5-flash

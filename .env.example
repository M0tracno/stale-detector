# Tavily: free key (1,000 searches/month, no card) at https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxx

# Groq: free key at https://console.groq.com/keys
# Read by Bifrost (bifrost/config.json -> "env.GROQ_API_KEY"), never by the app itself.
GROQ_API_KEY=gsk_xxxxxxxx

# Bifrost gateway (npm run bifrost -> http://localhost:8080)
BIFROST_URL=http://localhost:8080
# Optional: Bifrost virtual key for budgets / rate limits
BIFROST_VIRTUAL_KEY=

# Models are "provider/model" as configured in Bifrost
FAST_MODEL=groq/openai/gpt-oss-20b
STRONG_MODEL=groq/openai/gpt-oss-120b
# Comma-separated; Bifrost switches to these when the primary fails (e.g. Groq free-tier rate limit)
FALLBACK_MODELS=groq/openai/gpt-oss-20b
